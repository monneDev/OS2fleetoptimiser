{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["frontend", "backend", "worker", "runtime", "ingress", "mesh"],
  "properties": {
    "frontend": {
      "type": "object",
      "required": ["enabled", "image", "auth"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/definitions/image"},
        "auth": {
          "type": "object",
          "required": ["existingSecret"],
          "properties": {
            "existingSecret": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": ["enabled", "image"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "image": {"$ref": "#/definitions/image"}
      }
    },
    "worker": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["database", "rabbitmq", "valkey"],
      "properties": {
        "database": {"$ref": "#/definitions/dependency"},
        "rabbitmq": {"$ref": "#/definitions/dependency"},
        "valkey": {"$ref": "#/definitions/dependency"}
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"type": "string"}
      }
    },
    "mesh": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["host"],
      "properties": {
        "host": {"type": "string"}
      }
    }
  }
}
